# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_USER=rrc
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=rrc_inventory

# --- Bootstrap admin account ---
# Only used the first time the app starts against an empty database.
ADMIN_USERNAME=admin
# Leave empty to have a random password generated and printed in the backend logs.
ADMIN_PASSWORD=

# --- Origins allowed to call the API from a browser ---
# Set this to every origin users open the site on - scheme, host and port
# exactly as in the address bar, comma separated, no trailing slash. Include
# both the http:// and https:// forms if both are used, e.g.
#   ALLOWED_ORIGINS=http://10.1.69.243,https://10.1.69.243
# The site itself is same-origin and needs nothing else; this stops pages on
# other sites from driving the API with a visitor's browser. Left empty, any
# origin is allowed - set it.
ALLOWED_ORIGINS=

# --- HTTPS ---
# Address the HTTPS site (port 443) answers on: the server's IP or hostname,
# without http(s)://. Plain http:// keeps working either way. Caddy signs the
# certificate with its own local CA, so browsers warn until that CA is trusted
# (see README). Defaults to localhost.
# SITE_HOST=10.1.69.243

# --- 3D printers (optional) ---
# One entry per printer: Name|host|serial|accesscode, separated by commas.
# Serial and access code come off the printer screen with LAN mode enabled;
# tools/printer_discover.py prints the name, IP and serial for every printer.
# Leave unset to switch the printer page off entirely.
# PRINTERS=3DP-01P-279|192.168.2.101|01P00A411600279|xxxxxxxx,3DP-01P-739|192.168.2.102|01P00C580301739|xxxxxxxx
